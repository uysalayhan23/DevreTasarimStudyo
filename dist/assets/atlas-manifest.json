  "boundsMethod": {
    "alphaThreshold": 2,
    "paddingPixels": 4,
    "description": "Largest alpha >= 2 connected component at each visually verified subject position, expanded by 4 px on every side. This retains visible silhouette and shadow. Alpha=1 (0.4% opacity) detached/connected cutout haze is ignored only while deriving rectangles; source PNG pixels are unmodified."
  },
  "order": "Each atlas contains 16 subjects in the requested row-major order. No subject-order deviations.",
  "compositionNotes": [
    "Actual outputs are 1254 by 1254 pixels.",
    "Use per-object rectangles rather than equal quarter-grid cells; some physical silhouettes cross nominal cell boundaries.",
    "Atlas A is mostly straight-on; some Atlas B and C objects use visible three-quarter perspective.",
    "Original outputs contain occasional white/colored fringe pixels at cutout edges.",
    "Atlas C changeover contact body has two clearly visible front screw terminals; all app electrical ports/labels should be overlaid independently."
  ],
